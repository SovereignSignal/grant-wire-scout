# Local producer run artifacts — ephemeral, regenerated each run, never committed.
runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets / env (none committed; defensive)
.env
.env.*
*.secret
secrets/

# OS / editor
.DS_Store
*.log

# keep the template (the .env.* rule above would hide it)
!.env.example
