# grant-wire-scout — environment. Copy to .env for local runs, or set as Railway service
# variables. Real values are NEVER committed (.env is gitignored).

# ── Claude Code auth (rides the Claude.ai Max subscription — no API key) ──
CLAUDE_CODE_OAUTH_TOKEN=     # from `claude setup-token` (a long-lived sk-ant-oat... token)

# ── Grok Build auth (parallel lane — grok.com / SuperGrok, not a replacement) ──
# Preferred: paste the contents of ~/.grok/auth.json after `grok login`.
# Those sessions expire (~7 days) — rotate GROK_AUTH_JSON when the grok-scout AUTH-alerts.
# XAI_API_KEY is a console.x.ai *bill*, not the subscription. Leave unset unless you mean it.
GROK_AUTH_JSON=
# XAI_API_KEY=
GROK_MODEL=grok-4.6          # Grok Build flagship as of 2026-08-12; set grok-4.7 when it ships
GROK_HOME=                   # optional; default $HOME/.grok (Railway image: /app/home/.grok)

# ── Wire Room delivery (lib/submit.py) ──
WIRE_ROOM_API=https://wire-room-ops-production.up.railway.app
INTERNAL_API_KEY=            # wire-room-ops internal agent key (env-only; never a CLI arg)

# ── Model (Claude lane) ──
MODEL=claude-sonnet-4-6      # cron default (smoke-tested ≥ Opus at ~5x less quota); override per-run with --model claude-opus-4-8

# ── Scout cron (bin/run-all.sh / bin/run-grok-all.sh) ──
SCOUT_WIRES=crypto ai oss    # start with just "crypto" to be conservative
SCOUT_VARIANT=A              # A = broad-cast; B = tight-filter
# SCOUT_ENGINE=claude        # claude (default) | grok. run-grok-all.sh sets grok.
# SCOUT_SCAN_SOURCE=claude-code  # grok lane lands as grok-scout (existing WRO enum)
# SERVICE_ROLE=scout         # grok-scout | heartbeat. Guards the shared image.

# ── Alerting (lib/notify.py) — email via Resend ──
RESEND_API_KEY=              # the same Resend key wire-room-ops uses
NOTIFICATION_EMAIL=          # where alerts go (your ops email)
ALERT_FROM=Grant Wire Scout <scout@yourdomain.tld>   # MUST be a Resend-verified sender

# ── Heartbeat service only (lib/heartbeat.py) ──
DATABASE_URL=                # read access to the shared Wire Room Postgres
SCOUT_SILENCE_HOURS=26       # alert if no scan_source entries land in this many hours
# SCOUT_SCAN_SOURCE=claude-code  # set grok-scout on a *separate* heartbeat to watch Grok
